<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/wbg" android:padding="12dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#9FB4FF" android:textSize="12sp" android:text="Курсы"/>
    <TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="#FFFFFF" android:textSize="15sp" android:lineSpacingExtra="3dp" android:fontFamily="monospace"/>
    <TextView android:id="@+id/time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#8890A0" android:textSize="11sp"/>
</LinearLayout>
